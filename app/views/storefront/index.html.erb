<main>
  <h1>The Little Letter</h1>
  <p>A Winnipeg stationery shop for everyday notes, plans, and gifts.</p>
</main>

<h2>Shop stationery</h2>

<ul>
  <% @products.each do |product| %>
    <li>
      <h3><%= product.name %></h3>
      <p><%= product.description %></p>
      <p><%= number_to_currency(product.price_cents / 100.0) %> CAD</p>
    </li>
  <% end %>
</ul>
