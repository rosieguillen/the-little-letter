<main class="category-management">
  <header class="dashboard-heading">
    <div>
      <p class="dashboard-eyebrow">Catalogue organization</p>
      <h1>Edit category</h1>
      <p class="dashboard-account"><%= @category.name %></p>
    </div>
    <%= link_to "Back to categories", admin_categories_path, class: "dashboard-button dashboard-button-secondary" %>
  </header>

  <section class="category-panel category-form-panel category-edit-panel" aria-labelledby="category-details-heading">
    <h2 id="category-details-heading">Category details</h2>
    <p>Update the display name. Existing products stay assigned to this category, and its store URL is preserved.</p>
    <p class="category-url">Store URL: /categories/<%= @category.slug %></p>
    <% if @category.errors.any? %>
      <ul class="category-errors" role="alert">
        <% @category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <%= form_with model: @category, url: admin_category_path(@category), class: "category-management-form" do |form| %>
      <%= form.label :name, "Category name" %>
      <%= form.text_field :name, required: true %>
      <div class="category-form-actions">
        <%= form.submit "Save changes", class: "dashboard-button dashboard-button-primary" %>
        <%= link_to "Cancel", admin_categories_path, class: "dashboard-button dashboard-button-secondary" %>
      </div>
    <% end %>
  </section>
</main>
