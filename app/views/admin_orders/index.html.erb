<main class="order-history">
  <h1>Order history</h1>
  <p><%= link_to "Back to dashboard", admin_dashboard_path %></p>

  <% if @orders.empty? %>
    <p>No orders have been placed yet.</p>
  <% end %>

  <% @orders.each do |order| %>
    <%= render "shared/order_invoice", order: order, staff_view: true %>
  <% end %>

  <%= paginate @orders %>
</main>
