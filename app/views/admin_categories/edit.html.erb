
<main>
    <h1>Edit category</h1>
    <p><%= link_to "Back to categories", admin_categories_path %></p>

    <% if @category.errors.any? %>
        <ul role="alert">
            <% @category.errors.full_messages.each do |message| %>
                <li><%= message %></li>
            <% end %>
        </ul>
    <% end %>

    <%= form_with model: @category, url: admin_category_path(@category) do |form| %>
        <%= form.label :name, "Category name" %>
        <%= form.text_field :name, required: true %>
        <%= form.submit "Save changes" %>
    <% end %>

</main>