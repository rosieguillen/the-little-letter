<main class="category-management">
  <header class="dashboard-heading">
    <div>
      <p class="dashboard-eyebrow">Catalogue organization</p>
      <h1>Manage categories</h1>
      <p class="dashboard-account">Keep your stationery easy to browse.</p>
    </div>
    <%= link_to "Back to dashboard", admin_dashboard_path, class: "dashboard-button dashboard-button-secondary" %>
  </header>

  <div class="category-management-layout">
    <section class="category-panel" aria-labelledby="category-list-heading">
      <div class="dashboard-section-heading">
        <div>
          <h2 id="category-list-heading">Your categories</h2>
          <p><%= pluralize(@categories.size, "category") %> in your catalogue</p>
        </div>
      </div>
      <% if @categories.any? %>
        <ul class="category-management-list">
          <% @categories.each do |category| %>
            <li>
              <div>
                <strong><%= category.name %></strong>
                <span>Store URL: /categories/<%= category.slug %></span>
              </div>
              <%= link_to "Edit", edit_admin_category_path(category),
                class: "dashboard-button dashboard-button-secondary",
                aria: { label: "Edit #{category.name}" } %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="dashboard-empty">Add your first category to start organizing products.</p>
      <% end %>
    </section>

    <section class="category-panel category-form-panel" aria-labelledby="new-category-heading">
      <h2 id="new-category-heading">Add a category</h2>
      <p>Choose a name shoppers will recognize. A store URL is created automatically.</p>
      <% if @category.errors.any? %>
        <ul class="category-errors" role="alert">
          <% @category.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
      <%= form_with model: @category, url: admin_categories_path, class: "category-management-form" do |form| %>
        <%= form.label :name, "Category name" %>
        <%= form.text_field :name, required: true, placeholder: "e.g. Greeting cards" %>
        <%= form.submit "Add category", class: "dashboard-button dashboard-button-primary" %>
      <% end %>
    </section>
  </div>
</main>
