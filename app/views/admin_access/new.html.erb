<main>
  <h1>Staff sign-in</h1>

  <% if flash[:alert] %>
    <p role="alert"><%= flash[:alert] %></p>
  <% end %>

  <%= form_with url: admin_sign_in_path, scope: :admin do |form| %>
    <p>
      <%= form.label :username %>
      <%= form.text_field :username, required: true, autocomplete: "username" %>
    </p>
    <p>
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "current-password" %>
    </p>
    <%= form.submit "Sign in" %>
  <% end %>
</main>