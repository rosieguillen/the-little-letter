<main class="storefront">
  <% if @category %>
    <%= render "shared/breadcrumbs", category: @category %>
  <% end %>
  <p class="storefront-intro">A Winnipeg stationery shop for everyday notes, plans, and gifts.</p>

  <%= form_with url: root_path, method: :get, class: "catalogue-search" do |form| %>
    <div class="catalogue-search-field">
      <%= form.label :q, "Search stationery" %>
      <%= form.search_field :q, value: @keyword, placeholder: "Search notebooks, pens, and more" %>
    </div>
    <div class="catalogue-search-field">
      <%= form.label :category_slug, "Category" %>
      <%= form.collection_select :category_slug, @categories, :slug, :name,
        { include_blank: "All categories", selected: @category&.slug } %>
    </div>
    <div class="catalogue-search-field">
      <%= form.label :filter, "Show" %>
      <%= form.select :filter,
        [["All products", "all"], ["On sale", "sale"], ["New arrivals", "new"]],
        { selected: @filter } %>
    </div>
    <%= form.submit "Search", class: "catalogue-search-button" %>
  <% end %>


<h1><%= @category ? @category.name : "Shop stationery" %></h1>

<ul class="product-grid">
  <% @products.each do |product| %>
    <li>
      <h3><%= link_to product.name, product_path(product) %></h3>
      <% if product.photo.attached? %>
        <%= image_tag product.photo.variant(:thumbnail), alt: product.name, loading: "lazy" %>
      <% end %>
      <p><%= product.description %></p>
      <%= render "products/price", product: product %>
    </li>
  <% end %>
</ul>

<%= paginate @products %>

</main>
