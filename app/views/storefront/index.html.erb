<main>
  <h1>The Little Letter</h1>
  <p>A Winnipeg stationery shop for everyday notes, plans, and gifts.</p>
</main>

<nav aria-label="Product categories">
  <ul>
    <li><%= link_to "All stationery", root_path %></li>
    <% @categories.each do |category| %>
      <li><%= link_to category.name, category_path(category.slug) %></li>
    <% end %>
  </ul>
</nav>

<%= form_with url: root_path, method: :get do |form| %>
  <%= form.label :q, "Search stationery" %>
  <%= form.search_field :q, value: @keyword %>

  <%= form.label :category_slug, "Category" %>
  <%= form.collection_select :category_slug, @categories, :slug, :name,
    { include_blank: "All categories", selected: @category&.slug } %>
  <%= form.label :filter, "Show" %>
  <%= form.select :filter,
    [["All products", "all"], ["On sale", "sale"], ["New Arrivals", "new"]],
    { selected: @filter } %>

  <%= form.submit "Search" %>
<% end %>


<h2><%= @category ? @category.name : "Shop stationery" %></h2>

<ul>
  <% @products.each do |product| %>
    <li>
      <h3><%= link_to product.name, product_path(product) %></h3>
      <% if product.photo.attached? %>
        <%= image_tag product.photo.variant(:thumbnail), alt: product.name, loading: "lazy" %>
      <% end %>
      <p><%= product.description %></p>
      <%= render "products/price", product: product %>
    </li>
  <% end %>
</ul>

<%= paginate @products %>
